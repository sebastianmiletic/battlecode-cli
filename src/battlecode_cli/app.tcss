Screen { background: #0c0c0c; color: #e8e8e8; }
.hidden { display: none; }
#masthead { height: 3; padding: 0 2; background: #121212; border-bottom: solid #333333; }
#wordmark { width: 1fr; text-style: bold; margin-top: 1; }
#workspace { height: 1fr; }
#sidebar { width: 21; padding: 1; background: #121212; border-right: solid #333333; }
#sidebar-label { display: none; }
#nav { border: none; padding: 0; height: 1fr; background: transparent; }
#nav > .option-list--option { padding: 0 1; }
#nav > .option-list--option-highlighted { color: #101010; background: #e8e8e8; text-style: bold; }
#sidebar-note { color: #777777; height: 1; padding: 0 1; }
#pages { width: 1fr; height: 1fr; }
.page { padding: 1 2; }
.page-title { text-style: bold; height: 1; }
.section-title { text-style: bold; height: 2; padding-top: 1; }
.hint { color: #909090; height: auto; margin-bottom: 1; }
#team-summary { height: 1; text-style: bold; }
#rating-row { height: 5; margin-top: 1; }
#elo-metric { width: 2fr; }
#rank-metric { width: 1fr; }
.metric-label { height: 1; color: #a0a0a0; text-style: bold; }
Digits { height: 3; text-style: bold; }
#team-record { width: 2fr; height: 3; color: #a0a0a0; padding-top: 1; }
#history-row { height: 7; }
#elo-history { margin-right: 2; }
#active-summary { height: 2; color: #cccccc; }
#recent-panel { height: 1fr; }
TabbedContent, .tab-workspace { height: 1fr; }
TabPane { padding: 0; height: 1fr; }
ContentTabs { margin-bottom: 1; }
DataTable { height: 1fr; background: #0c0c0c; scrollbar-size: 1 1; }
DataTable > .datatable--header { background: #202020; color: #b0b0b0; text-style: bold; }
DataTable > .datatable--cursor { background: #e8e8e8; color: #101010; text-style: bold; }
DataTable > .datatable--hover { background: #2b2b2b; color: #eeeeee; }
DataTable:focus > .datatable--cursor { background: #e8e8e8; color: #101010; }
#bots-table, #games-table { min-height: 4; }
#overview-games { min-height: 4; }
.detail-area { height: auto; border-top: solid #333333; padding-top: 1; margin-top: 1; }
#bot-detail { height: 3; }
#game-detail { height: 1; }
#game-parts { height: 6; }
#games-filter { width: 29; margin-bottom: 1; }
.actions { height: 3; margin-top: 1; }
Button { background: #202020; color: #e8e8e8; border: none; min-width: 10; height: 3; padding: 0 2; margin-right: 1; text-style: none; }
Button:hover { background: #363636; }
Button:focus { background: #e8e8e8; color: #101010; text-style: bold; }
Button.primary { background: #e8e8e8; color: #101010; text-style: bold; }
Button.primary:hover { background: #cccccc; }
Button.primary:disabled { background: #252525; color: #666666; }
Button:disabled { color: #666666; background: #161616; }
#projects-link { width: auto; min-width: 0; height: 1; padding: 0; margin: 1 0 0 0; background: transparent; color: #a0a0a0; }
#projects-link:hover { color: #e8e8e8; text-style: underline; }
#projects-link:focus { color: #101010; background: #e8e8e8; }
Input { height: 3; max-width: 86; background: #161616; color: #e8e8e8; border: solid #454545; padding: 0 1; }
Input:focus { border: solid #d0d0d0; }
Input > .input--placeholder { color: #777777; }
Select { height: 3; max-width: 86; border: none; padding: 0; background: #161616; }
Select:focus > SelectCurrent { border: solid #d0d0d0; }
SelectOverlay { background: #202020; border: solid #777777; }
SelectCurrent { height: 3; padding: 0 1; border: solid #454545; background: #161616; color: #e8e8e8; }
SelectOverlay > .option-list--option-highlighted { color: #101010; background: #e8e8e8; }
SelectionList { height: 7; max-width: 86; background: #161616; border: solid #454545; padding: 0 1; }
SelectionList:focus { border: solid #cccccc; }
SelectionList > .option-list--option-highlighted { background: #303030; }
SelectionList > .selection-list--button { color: #e8e8e8; background: #161616; }
.field-label { height: 2; padding-top: 1; text-style: bold; }
.form-note { height: auto; max-width: 86; color: #aaaaaa; margin-top: 1; }
.form-status { height: auto; max-width: 86; color: #e8e8e8; margin-top: 1; }
#path-row, .path-row { height: 3; max-width: 86; }
.path-row Input, #upload-path { width: 1fr; }
.path-row Button, #browse-bot { margin-left: 1; margin-right: 0; }
#ladder-search { margin-bottom: 1; }
.empty { height: auto; color: #b0b0b0; padding: 1 0; display: none; }
#arena-setup { height: 1fr; }
#arena-progress { height: 2; color: #b0b0b0; }
#arena-summary { height: 3; color: #d0d0d0; }
#arena-runs-table { height: 6; }
#arena-results-table { min-height: 4; }
#arena-local-maps { height: 6; }
#arena-local .actions { margin-top: 0; }
Collapsible { padding: 0; border: none; margin: 1 0; background: transparent; }
Collapsible > Contents { padding: 0; }
Checkbox { background: #161616; border: none; padding: 1; margin-top: 1; }
#status-line { height: 1; background: #202020; color: #b8b8b8; padding: 0 2; }
Footer { background: #121212; color: #aaaaaa; }
Footer > .footer--key { color: #eeeeee; background: #303030; }
Footer > .footer--description { color: #aaaaaa; }
.compact #sidebar { width: 18; }
.compact Button { padding: 0 1; min-width: 8; }
.compact #sidebar-note { display: none; }
.short .page { padding: 0 2; }
.short #rating-row { height: 4; margin-top: 0; }
.short #history-row { height: 6; }
.short HistoryChart { height: 6; }
.short #recent-panel .section-title { height: 1; padding-top: 0; }
.short ContentTabs { margin-bottom: 0; }
.short .detail-area { margin-top: 0; padding-top: 0; }
.short #game-parts { height: 4; }
.short #games-filter { margin-bottom: 0; }
.short #game-matches .actions { margin-top: 0; }
.short #leaderboard-state { height: 1; margin-bottom: 0; }
ModalScreen { background: #0c0c0c 85%; align: center middle; }
.dialog { background: #161616; border: solid #777777; padding: 1 2; }
.confirm-dialog { width: 72; height: auto; max-height: 90%; }
.dialog-title { text-style: bold; height: 2; }
.dialog-copy { height: auto; margin-bottom: 1; }
.confirm-copy { height: auto; max-height: 40vh; }
.text-dialog { width: 90%; height: 85%; }
#text-log { height: 1fr; background: #161616; }
.file-dialog { width: 85%; height: 85%; }
#file-tree { height: 1fr; background: #161616; margin-top: 1; }
Toast { background: #242424; color: #eeeeee; border: solid #777777; }
LoadingIndicator { color: #cccccc; }
#accounts-table { height: 7; margin-top: 1; }
#accounts-empty { margin-top: 0; }
#replays-table { min-height: 4; }
#replay-path-row { height: 3; margin-top: 1; }
#replay-path { width: 1fr; }
#browse-replay { margin-left: 1; margin-right: 0; }
.replay-screen { padding: 0; }
#replay-heading, #replay-stats, #replay-legend, #replay-viewport,
#replay-inspector, #replay-timeline, #replay-position, #replay-buttons,
#replay-options { margin: 0 1; }
#replay-heading { height: 1; text-style: bold; }
#replay-stats { height: 2; color: #d0d0d0; }
#replay-legend { height: 1; color: #909090; }
#replay-viewport { height: 1fr; border: solid #333333; overflow: auto auto; scrollbar-size: 1 1; }
#replay-board { background: #0c0c0c; padding: 0; }
#replay-inspector { height: 1; color: #b0b0b0; }
#replay-timeline { height: 1; background: #161616; }
#replay-timeline:focus { background: #242424; }
#replay-position { height: 1; color: #b0b0b0; }
#replay-buttons { height: 3; margin-top: 0; }
#replay-options { height: 3; }
.replay-screen Button { min-width: 7; padding: 0 1; }
#replay-mode { width: 27; margin-right: 1; }
#replay-speed { width: 20; margin-right: 1; }
#replay-jump { width: 13; margin-right: 1; }
#replay-go { min-width: 7; }
