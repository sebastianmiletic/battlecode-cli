Screen {
    background: #0c0c0c;
    color: #e8e8e8;
}
#masthead {
    height: 3;
    padding: 0 2;
    background: #121212;
    border-bottom: solid #333333;
}
#wordmark { width: 1fr; text-style: bold; margin-top: 1; }
#connection { width: auto; color: #b0b0b0; margin-top: 1; }
#workspace { height: 1fr; }
#sidebar {
    width: 21;
    padding: 1 1;
    background: #121212;
    border-right: solid #333333;
}
#sidebar-label { color: #777777; height: 2; padding: 0 1; }
#nav { border: none; padding: 0; height: 1fr; background: transparent; }
#nav > .option-list--option { padding: 0 1; }
#nav > .option-list--option-highlighted {
    color: #101010;
    background: #e8e8e8;
    text-style: bold;
}
#sidebar-note { color: #777777; height: 4; padding: 0 1; }
#pages { width: 1fr; height: 1fr; }
.page { padding: 1 3; }
.eyebrow { color: #858585; height: 2; text-style: bold; }
.page-title { text-style: bold; height: 2; }
.section-title { text-style: bold; height: 2; padding-top: 1; }
.hint { color: #909090; height: auto; margin-bottom: 1; }
#team-summary { height: 5; }
#active-summary { height: 3; color: #cccccc; border-bottom: solid #333333; }
#overview-grid { height: 1fr; }
#recent-panel { width: 3fr; }
#versions-panel { width: 2fr; margin-left: 3; }
DataTable { height: 1fr; background: #0c0c0c; scrollbar-size: 1 1; }
DataTable > .datatable--header { background: #202020; color: #b0b0b0; text-style: bold; }
DataTable > .datatable--cursor { background: #e8e8e8; color: #101010; text-style: bold; }
DataTable > .datatable--hover { background: #2b2b2b; color: #eeeeee; }
DataTable:focus > .datatable--cursor { background: #e8e8e8; color: #101010; }
#bots-table, #games-table { min-height: 5; }
#overview-games, #overview-bots { min-height: 4; }
.detail-area { height: auto; border-top: solid #333333; padding-top: 1; margin-top: 1; }
#bot-detail { height: 3; }
#game-detail { height: 2; padding-top: 1; }
#game-parts { height: 7; margin-top: 1; }
.actions { height: 3; margin-top: 1; }
Button {
    background: #202020;
    color: #e8e8e8;
    border: none;
    min-width: 12;
    height: 3;
    padding: 0 2;
    margin-right: 1;
    text-style: none;
}
Button:hover { background: #363636; }
Button:focus { background: #e8e8e8; color: #101010; text-style: bold; }
Button.primary { background: #e8e8e8; color: #101010; text-style: bold; }
Button.primary:hover { background: #cccccc; }
Button.primary:disabled { background: #252525; color: #666666; }
Button:disabled { color: #666666; background: #161616; }
Input, Select {
    height: 3;
    max-width: 86;
    background: #161616;
    color: #e8e8e8;
    border: solid #454545;
    padding: 0 1;
}
Input:focus, Select:focus { border: solid #d0d0d0; }
Input > .input--placeholder { color: #777777; }
SelectOverlay { background: #202020; border: solid #777777; }
SelectCurrent { background: #161616; }
SelectOverlay > .option-list--option-highlighted { color: #101010; background: #e8e8e8; }
SelectionList {
    height: 7;
    max-width: 86;
    background: #161616;
    border: solid #454545;
    padding: 0 1;
}
SelectionList:focus { border: solid #cccccc; }
SelectionList > .option-list--option-highlighted { background: #303030; }
SelectionList > .selection-list--button { color: #e8e8e8; background: #161616; }
.field-label { height: 2; padding-top: 1; margin-top: 1; text-style: bold; }
.form-note { height: auto; max-width: 86; color: #aaaaaa; margin-top: 1; }
.form-status { height: auto; max-width: 86; color: #e8e8e8; margin-top: 1; }
#path-row { height: 3; max-width: 86; }
#upload-path { width: 1fr; }
#browse-bot { margin-left: 1; margin-right: 0; }
#ladder-search { margin-bottom: 1; }
.empty { height: auto; color: #b0b0b0; padding: 1 0; display: none; }
#status-line { height: 1; background: #202020; color: #b8b8b8; padding: 0 2; }
Footer { background: #121212; color: #aaaaaa; }
Footer > .footer--key { color: #eeeeee; background: #303030; }
Footer > .footer--description { color: #aaaaaa; }
.compact #sidebar { width: 16; }
.compact .page { padding: 1 2; }
.compact #versions-panel { display: none; }
.compact Button { padding: 0 1; min-width: 8; }
.compact #sidebar-note { display: none; }
.compact #game-parts { height: 5; }
.short .page { padding: 0 2; }
.short .eyebrow { display: none; }
.short .page-title { height: 1; }
.short #overview .hint, .short #bots .hint, .short #games .hint { display: none; }
.short #team-summary { height: 4; }
.short #active-summary { height: 2; }
.short .detail-area { margin-top: 0; padding-top: 0; }
.short #game-parts { height: 5; }
ModalScreen { background: #0c0c0c 85%; align: center middle; }
.dialog { background: #161616; border: solid #777777; padding: 1 2; }
.confirm-dialog { width: 72; height: auto; max-height: 90%; }
.dialog-title { text-style: bold; height: 2; }
.dialog-copy { height: auto; margin-bottom: 1; }
.confirm-copy { height: auto; max-height: 40vh; }
.text-dialog { width: 90%; height: 85%; }
#text-log { height: 1fr; background: #161616; }
.file-dialog { width: 85%; height: 85%; }
#file-tree { height: 1fr; background: #161616; margin-top: 1; }
Toast { background: #242424; color: #eeeeee; border: solid #777777; }
LoadingIndicator { color: #cccccc; }
